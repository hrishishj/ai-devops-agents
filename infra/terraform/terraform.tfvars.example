# ============================================================
# Terraform variable values — EXAMPLE FILE
# Copy to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to source control.
# ============================================================

# ─── Core ─────────────────────────────────────────────────────
prefix      = "aidvops"
environment = "staging"           # dev | staging | production
location    = "eastus2"
openai_location = "eastus"        # GPT-4o availability varies by region

# ─── Container Registry ───────────────────────────────────────
acr_login_server = "yourregistry.azurecr.io"
image_tag        = "latest"

# ─── GitHub App secrets ───────────────────────────────────────
# These are stored in Key Vault after first apply.
github_webhook_secret  = "your-webhook-hmac-secret"
github_app_id          = "123456"
github_app_private_key = <<-EOT
-----BEGIN RSA PRIVATE KEY-----
your-private-key-content-here
-----END RSA PRIVATE KEY-----
EOT
