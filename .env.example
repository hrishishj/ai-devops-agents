# Copy to .env for local development. In Azure these come from Key Vault / app settings.
DA_ENVIRONMENT=dev
DA_DATABASE_URL=sqlite+pysqlite:///./devopsagents.db
DA_KILL_SWITCH=false

# GitHub App
DA_GITHUB_APP_ID=
DA_GITHUB_APP_PRIVATE_KEY=
DA_GITHUB_WEBHOOK_SECRET=change-me-locally

# Ingress auth (shared secrets; empty = endpoint rejects everything)
DA_ALERT_TOKEN=
DA_ADMIN_TOKEN=

# Azure OpenAI (Entra auth via DefaultAzureCredential; no API key)
DA_OPENAI_ENDPOINT=
DA_MODEL_LARGE=gpt-4o
DA_MODEL_SMALL=gpt-4o-mini

# Optional
DA_SERVICEBUS_NAMESPACE=
DA_AUTOMATION_ACCOUNT_URL=
DA_LOG_ANALYTICS_WORKSPACE_ID=
DA_INCIDENT_REPO=
DA_INCIDENT_INSTALLATION_ID=0
DA_APPLICATIONINSIGHTS_CONNECTION_STRING=

# Verified test generation (isolated sandbox only; never run PR code in the worker)
DA_SANDBOX_ENDPOINT=
DA_SANDBOX_SESSION_ID=devopsagents

# --- Free LLM (default): any OpenAI-compatible endpoint ---
DA_LLM_PROVIDER=openai_compat
DA_LLM_BASE_URL=http://localhost:11434/v1
DA_LLM_API_KEY=
DA_LLM_MODEL_LARGE=qwen2.5-coder:7b
DA_LLM_MODEL_SMALL=qwen2.5-coder:7b
DA_LLM_JSON_MODE=true
# Actions / CLI mode auth (no GitHub App needed)
DA_GITHUB_TOKEN=

# --- Docker Compose (see docs/local-docker.md) ---
POSTGRES_PASSWORD=devopsagents
# Inside containers the LLM is the compose "ollama" service. Override only to use an external endpoint.
# COMPOSE_LLM_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CONTEXT_LENGTH=16384
# Optional webhook tunnel (docker compose --profile webhooks up -d)
SMEE_URL=

# --- Free incident path (docs/free-incidents.md) ---
DA_PROMETHEUS_URL=
DA_RUNBOOK_REPO=
DA_RUNBOOK_WORKFLOW=runbook.yml
DA_ADMIN_AUTH=token          # token | easyauth | github
DA_APPROVER_REPO=            # github mode: approvers need write access here (defaults to DA_INCIDENT_REPO)
DA_APPROVERS=                # github mode: optional comma-separated allow-list of logins
